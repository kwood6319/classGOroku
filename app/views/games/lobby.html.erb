<div class="lobby-page">
  <div class="lobby-header">
    <h1 class="setup-title">classGOroku</h1>
    <p class="setup-subtitle">Get ready to play</p>
    <%= button_to "Start Game", start_game_path(@game), method: :post, class: "btn-primary-action btn-primary-action--inline" %>
  </div>
  <%# Full width — Before You Start %>
  <div class="setup-card setup-card--full">
    <h2 class="setup-card-title">Before You Start</h2>
    <ul class="checklist checklist--horizontal">
      <li class="checklist-item">
        <span class="check">✓</span>
        Students are in their teams
      </li>
      <li class="checklist-item">
        <span class="check">✓</span>
        Each team has paper and pen
      </li>
      <li class="checklist-item">
        <span class="check">✓</span>
        The board is visible to all teams
      </li>
      <li class="checklist-item">
        <span class="check">✓</span>
        A dice is ready
      </li>
    </ul>
  </div>
  <%# Second row — Goal (hidden) and Teams %>
  <div class="lobby-grid">
    <%# GM only — goal square, hidden by default %>
    <div class="setup-card setup-card--highlight">
      <h2 class="setup-card-title">GM Only 👀</h2>
      <div class="gm-goal-wrapper" data-controller="reveal">
        <div class="gm-goal-hidden" data-reveal-target="hidden">
          <button class="btn-reveal" data-action="click->reveal#show">
            Reveal goal square
          </button>
        </div>
        <div class="gm-goal-revealed" data-reveal-target="content" style="display:none;">
          <p class="gm-hint">The goal square is:</p>
          <p class="gm-goal-square">#<%= @game.goal_square + 1 %></p>
          <p class="gm-hint-sub">Use this to give hints if teams are stuck.</p>
        </div>
      </div>
    </div>
    <%# Teams %>
    <div class="setup-card">
      <h2 class="setup-card-title">Teams</h2>
      <ul class="lobby-team-list">
        <% @teams.each do |team| %>
          <li class="lobby-team-item">
            <span class="lobby-team-dot" style="background-color: <%= team.color %>;"></span>
            <%= team.name %>
          </li>
        <% end %>
      </ul>
    </div>
  </div>
</div>
