<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "ClassGOroku" %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Class G Oroku">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="<%= yield :body_class %>">
    <%= yield %>
    <% if notice %>
      <% if notice.start_with?("WIN:") %>
        <% team_name = notice.sub("WIN:", "") %>
        <script>
          document.getElementById("win-team-name").textContent = "<%= j team_name %> wins!";
          document.getElementById("win-modal").style.display = "flex";
        </script>
      <% elsif notice.start_with?("INSTRUCTION:") %>
        <% parts = notice.split(":", 3) %>
        <% color = parts[1] %>
        <% instruction = parts[2] %>
        <script>
          const box = document.getElementById("instruction-modal-box");
          document.getElementById("modal-instruction-text").textContent = <%= raw instruction.to_json %>;
          document.getElementById("instruction-modal-team").textContent = "Your instruction";
          box.style.borderTop = "6px solid <%= color %>";
          document.getElementById("instruction-modal").style.display = "flex";
        </script>
      <% end %>
    <% end %>
  </body>
</html>
